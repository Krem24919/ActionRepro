{
  "extends": "./tsconfig.json",
  "include": ["src/**/*", "test/**/*", "vitest.config.ts"],
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "outDir": "dist-test-check",
    "types": ["node"],
