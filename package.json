{
  "name": "actionrepro",
  "version": "0.1.0",
  "description": "Turn a failed GitHub Actions run into a local reproducibility bundle. No LLM, no backend, no telemetry.",
  "license": "MIT",
  "author": "ActionRepro contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/example/ActionRepro.git"
  },
  "homepage": "https://github.com/example/ActionRepro#readme",
  "bugs": {
    "url": "https://github.com/example/ActionRepro/issues"
  },
  "keywords": [
    "ci",
    "github-actions",
    "reproducibility",
    "debugging",
    "cli",
    "devtools",
    "termux"
  ],
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.js",
  "bin": {
    "actionrepro": "./dist/cli.js"
  },
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test --max-warnings 0",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:build": "tsc --noEmit -p tsconfig.json",
    "ci": "npm run typecheck && npm run lint && npm run format && npm run build && npm test",
    "prepublishOnly": "npm run build",
    "smoke": "bash scripts/smoke.sh",
    "doctor": "node dist/cli.js doctor"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.3"
  }
}
